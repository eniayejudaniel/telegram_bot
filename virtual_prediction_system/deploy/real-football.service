[Unit]
Description=Real football prediction polling service
After=network-online.target virtual-prediction.service
Wants=network-online.target

[Service]
Type=simple
User=virtualpredict
Group=virtualpredict
WorkingDirectory=/opt/virtual-prediction
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/virtual-prediction/.env
ExecStart=/opt/virtual-prediction/.venv/bin/python -m real_football.runner
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/virtual-prediction/data

[Install]
WantedBy=multi-user.target
