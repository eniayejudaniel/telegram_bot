[Unit]
Description=SportyHero pre-result paper model validator
After=sportyhero-collector.service
Requires=sportyhero-collector.service

[Service]
Type=simple
User=sportyhero
Group=sportyhero
WorkingDirectory=/opt/virtual_predictor_hub/sportyhero_collector
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/virtual_predictor_hub/sportyhero_collector/.ml-venv/bin/python forward_predictor.py --source data/sportyhero.sqlite3 --ledger data/ml/forward.sqlite3 --registry data/ml --interval 1 --report-every 250
Restart=always
RestartSec=5
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/virtual_predictor_hub/sportyhero_collector/data/ml

[Install]
WantedBy=multi-user.target

