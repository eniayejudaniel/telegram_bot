[Unit]
Description=Bet9ja virtual prediction and betting bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=virtualpredict
Group=virtualpredict
WorkingDirectory=/opt/virtual-predictor-hub
EnvironmentFile=/opt/virtual-predictor-hub/.env
ExecStart=/usr/bin/xvfb-run -a /opt/virtual-predictor-hub/.venv/bin/python bet9ja_virtual_bot.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/virtual-predictor-hub/data

[Install]
WantedBy=multi-user.target
