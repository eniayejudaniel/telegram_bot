[Unit]
Description=Multi-user eBay TCG Telegram monitoring bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ebay_monitoring_bot
EnvironmentFile=/opt/ebay_monitoring_bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ebay_monitoring_bot/.venv/bin/python run.py
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ebay_monitoring_bot/data

[Install]
WantedBy=multi-user.target
