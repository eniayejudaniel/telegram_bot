[Unit]
Description=Kronos EURUSD forecast dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kronos-eurusd
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kronos-eurusd/.venv/bin/gunicorn --workers 1 --threads 2 --timeout 1800 --bind 0.0.0.0:8000 app:web
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
